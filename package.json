{
  "name": "agents-md-facts",
  "version": "0.1.0",
  "description": "Honest to a fault — a minimal AGENTS.md, authored from your repo's facts, never guessed.",
  "type": "module",
  "bin": {
    "agents-md-facts": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "agents.md",
    "agents-md",
    "ai-agents",
    "coding-agents",
    "context",
    "onboarding",
    "cli"
  ],
  "author": "James Wolfe (@Wolfe-Jam)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfe-Jam/agents-md-facts.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  }
}
