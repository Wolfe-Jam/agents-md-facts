faf_version: "3.0"
project:
  name: agents-md-facts
  goal: Honest to a fault — a minimal AGENTS.md, authored from your repo's facts, never guessed.
  main_language: TypeScript
  type: cli  # found: package.json bin
stack:
  frontend: slotignored
  css_framework: slotignored
  ui_library: slotignored
  state_management: slotignored
  backend: slotignored
  api_type: slotignored
  runtime: Node.js
  database: slotignored
  connection: slotignored
  hosting: npm
  build: TypeScript (tsc)
  cicd: GitHub Actions
  monorepo_tool: slotignored
  package_manager: bun
  workspaces: slotignored
  admin: slotignored
  cache: slotignored
  search: slotignored
  storage: slotignored
human_context:
  who: >-
    Developers and coding-agent users who want a short AGENTS.md that stays true
    to the tree — and maintainers teaching NONE→GOOD→BETTER→BEST.
  what: Honest to a fault — a minimal AGENTS.md, authored from your repo's facts, never guessed.
  why: >-
    Hand-written AGENTS.md rots; LLM-written ones often bloat and can reduce task
    success. Facts-authored instruction is the BETTER baseline; project.faf is
    optional BEST DNA on the same real product repo.
  where: https://github.com/Wolfe-Jam/agents-md-facts · npm agents-md-facts · MIT
  when: >-
    BETTER product on main/v0.1.0; BEST print slice on better-best/* tags
  how: bun run dev, bun run build, bun run test
monorepo:
  packages_count: slotignored
  build_orchestrator: slotignored
  versioning_strategy: slotignored
  shared_configs: slotignored
  remote_cache: slotignored
tech_stack:
  - TypeScript
key_files:
  - package.json
  - src/index.ts
  - src/cli.ts
  - README.md
  - tsconfig.json
commands:
  build: bun run build
  test: bun run test
  lint: bun run lint
  dev: bun run dev
